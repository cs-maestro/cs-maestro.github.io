---
import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"news">;
}

const { item } = Astro.props;
const { Content } = await item.render();

const formatted = item.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<article class="news-item">
  <p class="when mono">{formatted}</p>
  <div class="body">
    <Content />
  </div>
</article>

<style>
  .news-item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }

  .news-item:first-of-type {
    border-top: none;
  }

  .when {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-top: 0.15rem;
  }

  .body :global(p) {
    margin: 0;
  }

  .body :global(img) {
    max-width: 220px;
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .news-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
