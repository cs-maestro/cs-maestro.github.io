---
const links = [
  { label: "Email", href: "mailto:mdanish@unm.edu" },
  { label: "GitHub", href: "https://github.com/cs-maestro" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/cs-maestro" },
];
---

<ul class="social-links">
  {
    links.map((link) => (
      <li>
        <a href={link.href} target={link.href.startsWith("mailto:") ? undefined : "_blank"} rel="noopener">
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social-links a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
  }

  .social-links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
