---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Recognition {
  year: number;
  title: string;
  organization: string;
  links: { label: string; href: string }[];
}

const awards: Recognition[] = [
  {
    year: 2026,
    title: "Distinguished Artifact Evaluator",
    organization: "IEEE Symposium on Security and Privacy (S&P)",
    links: [{ label: "Award announcement", href: "https://sp2026.ieee-security.org/awards_artifacts.html" }],
  },
  {
    year: 2026,
    title: "Distinguished Artifact Reviewer",
    organization: "Privacy Enhancing Technologies Symposium (PETS)",
    links: [{ label: "Award announcement", href: "https://petsymposium.org/reviewer-awards.php" }],
  },
  {
    year: 2025,
    title: "Outstanding Undergraduate Researcher Award — Honorable Mention",
    organization: "Computing Research Association (CRA)",
    links: [{ label: "Certificate", href: "/img/cra_certificate.jpg" }],
  },
  {
    year: 2022,
    title: "NMEF Scholarship",
    organization: "New Mexico Engineering Foundation",
    links: [{ label: "Foundation", href: "https://nmef.net/index.html" }],
  },
];

const recognition: Recognition[] = [
  {
    year: 2026,
    title: "Invited guest, Research Saturday",
    organization: "N2K CyberWire · Research on SMS-delivered URLs",
    links: [
      { label: "Podcast episode", href: "https://thecyberwire.com/podcasts/research-saturday/410/notes" },
      { label: "Ars Technica coverage", href: "https://arstechnica.com/security/2026/01/millions-of-people-imperiled-through-sign-in-links-sent-by-sms/" },
    ],
  },
  {
    year: 2026,
    title: "Undergraduate Research Highlight: “Superhero” Research to Defend User Privacy",
    organization: "Computing Research News · Computing Research Association",
    links: [{ label: "Read the feature", href: "https://cra.org/crn/2026/01/undergraduate-research-highlight-superhero-research-to-defend-user-privacy/" }],
  },
];

const sections = [
  { title: "Awards", entries: awards },
  { title: "Research recognition", entries: recognition },
];
---

<BaseLayout title="Awards & Recognition" description="Awards, scholarships, and research recognition received by Muhammad Danish.">
  <section class="container wide awards-page">
    <p class="eyebrow">Honors &amp; Research Recognition</p>
    <h1>Awards &amp; Recognition</h1>
    {
      sections.map((section) => (
        <section class="recognition-section">
          <h2>{section.title}</h2>
          {section.entries.map((entry) => (
            <article class="timeline-row">
              <p class="when">{entry.year}</p>
              <div>
                <h3>{entry.title}</h3>
                <p class="organization">{entry.organization}</p>
                <ul class="recognition-links mono">
                  {entry.links.map((link) => (
                    <li><a href={link.href} target="_blank" rel="noopener">{link.label}</a></li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .awards-page {
    padding-top: 3rem;
  }

  .recognition-section {
    margin-top: 2.5rem;
  }

  .recognition-section h2 {
    margin-bottom: 0;
  }

  .timeline-row {
    grid-template-columns: 80px minmax(0, 1fr);
  }

  .when {
    margin: 0;
  }

  h3 {
    font-size: 1.15rem;
  }

  .organization {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .recognition-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .awards-page {
      padding-top: 1.5rem;
    }

    .timeline-row {
      grid-template-columns: 1fr;
    }
  }
</style>
